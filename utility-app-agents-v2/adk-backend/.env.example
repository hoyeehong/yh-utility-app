# ── LLM Backend (non-Gemini via LiteLLM) ─────────────────────────────────────
LLM_MODEL=gemini-3.7-flash
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Google Cloud / Vertex AI ──────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=utility-app-504808
GOOGLE_CLOUD_LOCATION=asia-southeast1
FIRESTORE_DATABASE_ID=utility-app-firestore

# ── Firestore collection ──────────────────────────────────────────────────────
# Bill records are stored at: users/{uid}/bill_records/{recordId}
# This env var is only needed if you override the default collection path.
# FIRESTORE_BILLS_COLLECTION=bill_records

# ── Firebase Admin SDK (server-side Firestore writes from ADK backend) ────────
# Download from Firebase Console → Project Settings → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ── Next.js proxy target ──────────────────────────────────────────────────────
# Set in the Next.js .env.local, not here. Listed for reference.
# ADK_BACKEND_URL=http://localhost:8000

# ── Observability & Evaluations (Arize / Phoenix / OpenTelemetry) ─────────────
# Set to 'true' to enable tracing and metrics
ENABLE_ARIZE_OBSERVABILITY=true
# Launch local Phoenix server automatically on port 6006 if true
PHOENIX_AUTO_LAUNCH=true
# Phoenix / OTLP Collector trace endpoint (defaults to http://localhost:6006/v1/traces)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Optional: Set for streaming traces to managed Arize Cloud
# ARIZE_SPACE_ID=your-arize-space-id
# ARIZE_API_KEY=your-arize-api-key
