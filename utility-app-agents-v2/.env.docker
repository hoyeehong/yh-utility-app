# .env.docker
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to .env (gitignored) and fill in your secrets.
# docker-compose reads .env automatically from the project root.
# ─────────────────────────────────────────────────────────────────────────────

# ── Model Selection (OpenRouter, Gemini, Groq, Claude, OpenAI) ──────────────
# Model options:
#   - OpenRouter (Qwen, DeepSeek, Claude, Llama): openrouter/qwen/qwen-2.5-vl-72b-instruct, openrouter/anthropic/claude-3.5-sonnet
#   - Gemini (Google AI Studio / Vertex AI):      gemini-3.1-flash, gemini-3.1-pro
#   - Groq LPU Vision (Llama 3.2 VLM):             groq/llama-3.2-11b-vision-preview
#   - Anthropic (Claude via LiteLLM):              anthropic/claude-3-7-sonnet-20250219, anthropic/claude-3-5-sonnet-20241022
#   - OpenAI (GPT via LiteLLM):                    openai/gpt-4o, openai/gpt-4.5-preview
LLM_MODEL=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=utility-app-504808
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Absolute path on your HOST machine to the GCP service account key JSON.
GCP_KEY_PATH=/path/to/your/secrets/utility-app-504808-firebase-adminsdk.json

# ── Firebase (utility-app-504808) ─────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAJhX3CKm_y85x61wsyAM8DaVXAHb2XRM4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=utility-app-504808.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=utility-app-504808
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=utility-app-504808.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=294296399024
NEXT_PUBLIC_FIREBASE_APP_ID=1:294296399024:web:e05535fff5c6776e365f75

# ── Cloud Run (used by deploy.sh) ─────────────────────────────────────────────
GCP_REGION=asia-southeast1
GAR_REPO=utility-app-images
BACKEND_SERVICE_NAME=utility-adk-backend
FRONTEND_SERVICE_NAME=utility-frontend
IMAGE_TAG=latest

# ── Observability & Evaluation (Arize / Phoenix / OpenTelemetry) ─────────────
ENABLE_ARIZE_OBSERVABILITY=true
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
# Optional: Set for streaming to Arize Cloud
# ARIZE_SPACE_ID=
# ARIZE_API_KEY=
